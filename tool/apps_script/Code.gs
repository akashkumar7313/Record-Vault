/**
 * RecordVault — Google Apps Script Web App backend (reference implementation).
 *
 * SECURITY WARNING
 * ----------------
 * A Web App deployed with "Anyone" access is PUBLIC. Anyone with the /exec URL
 * can read and write every record. Do NOT store real personal data here until
 * you put this script behind authentication and access control, for example:
 *   - Deploy as a Google Workspace add-on / restrict to a Workspace domain.
 *   - Verify an OAuth token or a shared secret header on every request, and
 *     reject requests that fail verification.
 *   - Bind the script to a restricted spreadsheet.
 * Use dummy data until then.
 *
 * API CONTRACT
 * ------------
 *   GET  : returns { "status": "success", "records": [ ... ] }
 *   POST : { "action": "add"    | "update" | "upsert" | "delete",
 *            "record": { ... } }   // for delete only "id" is required
 *          returns { "status": "success", "action": <action>, "id": <id> }
 *          on failure returns { "error": "<message>" }
 *
 * Records are matched by their `id` (UUID generated by the app), which makes
 * `add` idempotent: retrying a failed request updates the existing row instead
 * of creating a duplicate.
 */

var SHEET_NAME = 'Records';

var COLUMNS = [
  'id',
  'fullName',
  'fatherName',
  'motherName',
  'mobileNumber',
  'email',
  'address',
  'dateOfBirth',
  'gender',
  'createdAt',
  'updatedAt'
];

function getSheet_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(SHEET_NAME);
  }
  if (sheet.getLastRow() === 0) {
    sheet.appendRow(COLUMNS);
  }
  return sheet;
}

function json_(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

function doGet() {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var sheet = getSheet_();
    var values = sheet.getDataRange().getValues();
    if (values.length <= 1) {
      return json_({ status: 'success', records: [] });
    }
    var header = values[0];
    var records = [];
    for (var r = 1; r < values.length; r++) {
      var row = values[r];
      var record = {};
      for (var c = 0; c < header.length; c++) {
        record[header[c]] = row[c];
      }
      if (record.id) {
        records.push(record);
      }
    }
    return json_({ status: 'success', records: records });
  } catch (err) {
    return json_({ error: String(err) });
  } finally {
    lock.releaseLock();
  }
}

function doPost(e) {
  if (!e || !e.postData || !e.postData.contents) {
    return json_({ error: 'Empty request body' });
  }

  var body;
  try {
    body = JSON.parse(e.postData.contents);
  } catch (err) {
    return json_({ error: 'Invalid JSON body' });
  }

  var action = String(body.action || '').toLowerCase();
  var record = body.record || {};

  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var sheet = getSheet_();
    var values = sheet.getDataRange().getValues();
    var header = values[0];
    var idIndex = header.indexOf('id');

    var rowIndex = -1;
    var recordId = String(record.id || '');
    if (recordId) {
      for (var r = 1; r < values.length; r++) {
        if (String(values[r][idIndex]) === recordId) {
          rowIndex = r + 1; // 1-based sheet row
          break;
        }
      }
    }

    switch (action) {
      case 'add':
      case 'upsert':
        // Upsert by id so retries cannot create duplicates.
        if (rowIndex > 0) {
          writeRow_(sheet, header, rowIndex, record);
          return json_({ status: 'success', action: 'updated', id: recordId });
        }
        appendRow_(sheet, header, record);
        return json_({ status: 'success', action: 'added', id: recordId });

      case 'update':
        if (rowIndex <= 0) {
          return json_({ error: 'Record not found: ' + recordId });
        }
        writeRow_(sheet, header, rowIndex, record);
        return json_({ status: 'success', action: 'updated', id: recordId });

      case 'delete':
        if (!recordId) {
          return json_({ error: 'Missing record id' });
        }
        if (rowIndex <= 0) {
          // Already gone — treat as a successful delete (idempotent).
          return json_({ status: 'success', action: 'deleted', id: recordId });
        }
        sheet.deleteRow(rowIndex);
        return json_({ status: 'success', action: 'deleted', id: recordId });

      default:
        return json_({ error: 'Unknown action: ' + action });
    }
  } catch (err) {
    return json_({ error: String(err) });
  } finally {
    lock.releaseLock();
  }
}

function appendRow_(sheet, header, record) {
  var row = header.map(function (key) {
    return record[key] !== undefined && record[key] !== null ? record[key] : '';
  });
  sheet.appendRow(row);
}

function writeRow_(sheet, header, rowIndex, record) {
  var range = sheet.getRange(rowIndex, 1, 1, header.length);
  var existing = range.getValues()[0];
  var updated = header.map(function (key, i) {
    if (record[key] !== undefined && record[key] !== null) {
      return record[key];
    }
    return existing[i];
  });
  range.setValues([updated]);
}
